# Local settings. Copy this file to .env (ignored by git) and fill it in.
# Read by the tools/*.sh scripts (tools/lib.sh), by tools/make_baremetal_efi.py (SMBIOS identity) and by make.

# --- the console -------------------------------------------------------------------------------------------------------------
# IP of the PS5 while it runs Linux: the ssh target of tools/clean_run.sh, ktty_run.sh, return_run.sh, tripwire_run.sh
PS5_LINUX_HOST=192.168.0.50
PS5_LINUX_USER=root

# IP of the PS5 while it listens for the payload (jailbreak side; `make deploy`, tools/deploy.sh, tools/launch_hackintosh.sh)
PS5_HOST=192.168.0.50
FTP_PORT=2121

# --- Mac identity for the OpenCore config -------------------------------------------------------------------------------------
# Generated on the first build if left out (random values, saved here). GenSMBIOS (iMac20,2) values are better if you have them.
# SMBIOS_SERIAL=
# SMBIOS_MLB=
# SMBIOS_UUID=
# SMBIOS_ROM=

# --- the old QEMU/KVM rehearsal VM -------------------------------------------------------------------------------------------
# VNC_PASSWORD=changeme

# --- payload build -----------------------------------------------------------------------------------------------------------
# PS5_PAYLOAD_SDK=$HOME/.local/ps5-payload-sdk
# PS5_CLANG=clang
# BUILD_JOBS=8
# USE_CCACHE=0
# DEPLOY_DRY_RUN=0
