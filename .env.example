#
# Copy this file to .env. The local .env file is ignored by Git and read by
# Make; keep application identity and release metadata in sce_sys/param.json.

PS5_PAYLOAD_SDK=/Users/rodrigo/.local/ps5-payload-sdk
PS5_CLANG=clang
PS5_HOST=192.168.1.91
FTP_PORT=2121
DEPLOY_DRY_RUN=0
USE_CCACHE=0
BUILD_JOBS=2

# PACBREW_PACKAGES=sdl2 openssl

# Defaults to all available logical CPUs; lower this on memory-limited hosts.
# BUILD_JOBS=8
# USE_CCACHE=0
