#!/bin/sh
#
# PS5 Hackintosh — initramfs init (PID 1)
#
# Este script se ejecuta al arrancar Linux en la PS5.
# Monta el USB, localiza el rootfs o la imagen de macOS,
# y lanza QEMU/KVM con OpenCore para bootear macOS.
#
# El usuario ve macOS directamente en su TV — nada de Linux.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /tmp
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /dev/shm
mount -t tmpfs    tmpfs    /tmp

exec > /dev/console 2>&1
clear

echo ""
echo " ╔══════════════════════════════════════════════╗"
echo " ║         PS5 Hackintosh Loader v1.0           ║"
echo " ║         Arrancando macOS...                  ║"
echo " ╚══════════════════════════════════════════════╝"
echo ""

# ── Cargar módulos del kernel ──────────────────────────
echo "[hackintosh] Cargando módulos..."
for mod in kvm kvm_amd vfio vfio-pci vfio-iommu-type1 \
           virtio virtio_blk virtio_net virtio_scsi \
           loop usb_storage amdgpu snd_hda_intel; do
    modprobe -q $mod 2>/dev/null
done

# ── Esperar dispositivos USB ───────────────────────────
echo "[hackintosh] Esperando almacenamiento USB..."
sleep 3

# ── Buscar y montar USB con el directorio macos/ ──────
USB_DEV=""
mkdir -p /mnt/usb

for dev in /dev/sd[a-z]1 /dev/sd[a-z]2 /dev/sd[a-z] \
           /dev/nvme0n1p1 /dev/nvme0n1p2; do
    [ -b "$dev" ] || continue

    for fs in vfat exfat ext4; do
        if mount -t $fs "$dev" /mnt/usb 2>/dev/null; then
            if [ -d /mnt/usb/macos ]; then
                USB_DEV="$dev"
                echo "[hackintosh] USB montado: $dev ($fs)"
                break 2
            fi
            umount /mnt/usb 2>/dev/null
        fi
    done
done

if [ -z "$USB_DEV" ]; then
    echo ""
    echo "[hackintosh] ERROR: No se encontró USB con directorio macos/"
    echo ""
    echo "  El USB debe contener:"
    echo "    /macos/macOS.img      — imagen de disco de macOS"
    echo "    /macos/OVMF_CODE.fd   — firmware UEFI"
    echo "    /macos/OpenCore.img   — imagen del bootloader OpenCore"
    echo ""
    echo "  Opcional:"
    echo "    /macos/EFI/           — OpenCore EFI (alternativa a imagen)"
    echo ""
    echo "[hackintosh] Abriendo shell de emergencia..."
    exec /bin/sh
fi

# ── Verificar archivos necesarios ──────────────────────
MACOS_IMG="/mnt/usb/macos/macOS.img"
OVMF_CODE="/mnt/usb/macos/OVMF_CODE.fd"
OC_IMG="/mnt/usb/macos/OpenCore.img"

missing=""
[ ! -f "$MACOS_IMG" ] && missing="$missing macOS.img"
[ ! -f "$OVMF_CODE" ] && missing="$missing OVMF_CODE.fd"

if [ -n "$missing" ]; then
    echo "[hackintosh] ERROR: Faltan archivos:$missing"
    echo "[hackintosh] Abriendo shell..."
    exec /bin/sh
fi

# ── Crear OVMF_VARS si no existe ──────────────────────
OVMF_VARS="/mnt/usb/macos/OVMF_VARS.fd"
if [ ! -f "$OVMF_VARS" ]; then
    echo "[hackintosh] Creando NVRAM store..."
    cp "$OVMF_CODE" /tmp/OVMF_VARS.fd
    OVMF_VARS="/tmp/OVMF_VARS.fd"
fi

# ── Hugepages para KVM ────────────────────────────────
echo "[hackintosh] Configurando memoria..."
echo 4096 > /proc/sys/vm/nr_hugepages 2>/dev/null || true
mkdir -p /dev/hugepages
mount -t hugetlbfs hugetlbfs /dev/hugepages 2>/dev/null || true

# ── Lanzar macOS ──────────────────────────────────────
echo "[hackintosh] Lanzando macOS..."
exec /scripts/boot-macos.sh "$MACOS_IMG" "$OVMF_CODE" "$OVMF_VARS" "$OC_IMG"
